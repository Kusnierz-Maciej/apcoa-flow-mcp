# Secret settings for apcoa-flow-mcp (loaded via env_file in docker-compose).
# Non-secret settings (cost cap, parking-data refresh, etc.) live in docker-compose.prod.yml
# and can also be overridden here with the Section__Key convention if you prefer.

# ── Authentication ──────────────────────────────────────────────────────────
# Clients reach /mcp one of two ways:
#   1. OAuth 2.1  — the client runs the login flow; the user enters an API key (below) plus
#      their own APCOA email + password on the login screen. Nothing APCOA-specific is stored here.
#   2. Legacy headers — X-Api-Key (Security__ApiKey below) + Authorization: Basic base64(email:password).
#
# NOTE: there is NO server-side default APCOA account for HTTP mode anymore — every HTTP caller
# supplies their own APCOA credentials (via the OAuth login screen or the Basic header).

# API keys allowed to authorize (OAuth login) and to use the legacy X-Api-Key header. Add as many
# as you need; remove one and restart to force-end every session that was created with it.
Security__AllowedApiKeys__0=change-me-to-a-guid-or-long-random-string
# Security__AllowedApiKeys__1=another-key-for-a-second-user

# Legacy single key (optional) — still accepted on the X-Api-Key header path for older clients.
# Security__ApiKey=change-me-to-a-guid-or-long-random-string

# Secret that seeds OAuth token encryption. REQUIRED for OAuth. Must be a long random value and
# kept STABLE — changing it invalidates every issued token (all users must re-authorize).
Security__TokenSecret=change-me-to-a-long-random-secret

# ── Stdio mode only ─────────────────────────────────────────────────────────
# When running with --stdio (the client spawns the server as a subprocess), there is no OAuth and no
# API key: the single APCOA account comes from these. They are NOT used in HTTP mode.
# ApcoaFlow__Email=your@email.com
# ApcoaFlow__Password=yourpassword
