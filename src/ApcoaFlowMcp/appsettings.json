{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "System.Net.Http.HttpClient": "Information",
      "ModelContextProtocol": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "RequireMcpApiKey": true
  },
  "OAuth": {
    "AuthorizationCodeLifetime": "00:01:00",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "365.00:00:00"
  },
  "Telemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ApcoaFlow": {
    "MaxSessionCostPln": 100,
    "CurrentLocationRadiusMeters": 300
  },
  "Prompts": {
    "Enabled": true
  },
  "RateLimit": {
    "TokenLimit": 10,
    "ReplenishmentPeriod": "00:00:01"
  },
  "ParkingData": {
    "StorePath": "./tmp/data/parking",
    "SoftRefreshAge": "12:00:00",
    "HardRefreshAge": "48:00:00",
    "BackgroundRefreshInterval": "24:00:00",
    "GeohashPrecision": 6,
    "CompanyId": 9
  }
}
